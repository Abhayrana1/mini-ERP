cat > vercel.json <<'EOF'
{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "framework": "express",
      "entrypoint": "dist/server.js"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
EOF
